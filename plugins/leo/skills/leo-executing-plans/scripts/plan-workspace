#!/usr/bin/env bash
# Resolve and ensure the git-ignored directory that holds one plan's scratch:
# ledger, task briefs, implementer reports, review packages. Prints its
# absolute path.
#
# One directory per plan (.agents/executing-plans/<plan-basename>/) so a
# later plan in the same working tree never reads another plan's ledger.
# Basename slugs can collide (docs/a/plan.md vs docs/b/plan.md), so each
# directory records its owning plan in a plan-path marker; a directory owned
# by another plan is skipped and the slug is disambiguated with the plan's
# parent directory name, then a counter.
#
# The directory lives in the working tree, not under .git/, because agent
# runtimes commonly deny writes inside .git/. A self-ignoring .gitignore at
# the top keeps it out of `git status` and out of commits.
#
# Usage: plan-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: plan-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
base="$root/.agents/executing-plans"

# Physical path, so relative, absolute and ../ spellings of one plan match.
# The marker is repo-relative inside the repo, absolute outside it.
plan_dir=$(CDPATH='' cd -- "$(dirname "$plan")" && pwd -P)
plan_abs="$plan_dir/$(basename "$plan")"
case "$plan_abs" in
  "$root"/*) plan_id=${plan_abs#"$root"/} ;;
  *)         plan_id=$plan_abs ;;
esac

# Succeeds when directory $1 belongs to this plan, claiming it if unmarked.
owns() {
  if [ -e "$1/plan-path" ]; then
    [ "$(cat "$1/plan-path")" = "$plan_id" ]
  else
    mkdir -p "$1"
    printf '%s\n' "$plan_id" > "$1/plan-path"
  fi
}

dir="$base/$slug"
if ! owns "$dir"; then
  parent=$(basename "$plan_dir")
  dir="$base/$slug-$parent"
  if ! owns "$dir"; then
    n=2
    while ! owns "$base/$slug-$parent-$n"; do n=$((n + 1)); done
    dir="$base/$slug-$parent-$n"
  fi
fi

printf '*\n' > "$base/.gitignore"
CDPATH='' cd -- "$dir" && pwd
